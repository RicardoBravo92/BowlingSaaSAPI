# Database Connection
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# Security
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
cors_origins=["http://localhost:3000", "http://localhost:5173"]

# Environment: development | staging | production
APP_ENV=development
# SQL logging only when debugging is enabled
DEBUG=false

# Frontend base URL used to build password-reset links
FRONTEND_URL=http://localhost:3000

# Set to true only when the API runs behind nginx/load balancer (rate limiting
# will then trust the left-most X-Forwarded-For value)
BEHIND_PROXY=false

# Email (SMTP) Settings
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=no-reply@bowlingsaas.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Business timezone (IANA name) used to block past booking hours
TIMEZONE=America/Caracas

# Seed passwords (required in production; falls back to dev defaults otherwise)
SEED_OWNER_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_CASHIER_PASSWORD=
SEED_MAINTENANCE_PASSWORD=
SEED_USER_PASSWORD=